# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local: mongodb://127.0.0.1:27017/product_management
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/product_management
MONGO_URI=mongodb://127.0.0.1:27017/product_management


# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Seed admin (used by src/seed.js)
SEED_ADMIN_EMAIL=admin@test.com
SEED_ADMIN_PASSWORD=Admin@123
